// MOS 性能基准测试 - 使用局部变量

int bench_arithmetic() {
    int sum = 0
    int i = 0
    for (i = 1; i <= 1000000; i = i + 1) {
        sum = sum + i * 2 - 1
        sum = sum / 2
        sum = sum % 100
    }
    return sum
}

int add(int a, int b) {
    return a + b
}

int bench_function_call() {
    int sum = 0
    int i = 0
    for (i = 1; i <= 500000; i = i + 1) {
        sum = add(sum, i)
    }
    return sum
}

int bench_loop() {
    int sum = 0
    int i = 0
    for (i = 1; i <= 2000000; i = i + 1) {
        sum = sum + 1
    }
    return sum
}

int main() {
    float start = os.clock()
    int r1 = bench_arithmetic()
    float t1 = (os.clock() - start) * 1000
    print("arithmetic:", t1, "ms, result=", r1)

    start = os.clock()
    int r2 = bench_function_call()
    float t2 = (os.clock() - start) * 1000
    print("function_call:", t2, "ms, result=", r2)

    start = os.clock()
    int r3 = bench_loop()
    float t3 = (os.clock() - start) * 1000
    print("loop:", t3, "ms, result=", r3)

    float total = t1 + t2 + t3
    print("total:", total, "ms")
    return 0
}
