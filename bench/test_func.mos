// 简单算术测试 - 使用函数
int test() {
    int N = 100000000
    int a = 0
    int b = 1
    int c = 2
    int i = 0
    for (i = 1; i <= N; i = i + 1) {
        a = a + b * c
    }
    return a
}

float start = os.clock()
int result = test()
float elapsed = (os.clock() - start) * 1000
print("arith: a=", result, " time=", elapsed)
