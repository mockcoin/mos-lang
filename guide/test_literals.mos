// Test: Literals
int a = 10
int b = -5
int c = 0xFF
int d = 0x1A
float pi = 3.14
float e = 2.718
float small = 0.001
String s1 = "Hello"
String s2 = 'World'
bool flag = true
bool disabled = false
print("a =", a, "b =", b)
print("c =", c, "d =", d)
print("pi =", pi, "e =", e, "small =", small)
print("s1 =", s1, "s2 =", s2)
print("flag =", flag, "disabled =", disabled)
